!data/.gitkeep
!corpus/.gitkeep
!corpus/lectures/.gitkeep
!corpus/slides/.gitkeep
!corpus/notes/.gitkeep
!corpus/handwritten/.gitkeep

# Evaluation outputs
evaluation/results/

# OS junk
.DS_Store
Thumbs.db
